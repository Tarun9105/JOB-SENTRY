{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobSentrySharedContracts",
  "description": "Canonical JSON Schema definitions for JobSentry FakeJobScanner",
  "definitions": {
    "RiskLevel": {
      "type": "string",
      "enum": ["Low", "Medium", "High"]
    },
    "AppStage": {
      "type": "string",
      "enum": ["staging", "production"]
    },
    "JobCheckInput": {
      "type": "object",
      "properties": {
        "jobText": { "type": "string", "minLength": 10 },
        "job_text": { "type": "string", "minLength": 10 },
        "email": { "type": "string", "format": "email" },
        "company": { "type": "string", "maxLength": 120 },
        "salary": { "type": "string" },
        "stage": { "$ref": "#/definitions/AppStage" }
      },
      "anyOf": [
        { "required": ["jobText"] },
        { "required": ["job_text"] }
      ],
      "additionalProperties": false
    },
    "JobCheckOutput": {
      "type": "object",
      "required": ["riskLevel", "risk_level", "score", "redFlags", "red_flags", "advice", "stage", "evaluatedAt"],
      "properties": {
        "riskLevel": { "$ref": "#/definitions/RiskLevel" },
        "risk_level": { "$ref": "#/definitions/RiskLevel" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "redFlags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "red_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "advice": {
          "type": "array",
          "items": { "type": "string" }
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "category", "description"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "category": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "stage": { "$ref": "#/definitions/AppStage" },
        "evaluatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
